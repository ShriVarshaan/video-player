    "@vitejs/plugin-react": "^6.1.2",
    "7zip-bin": "^5.2.0",
    "electron": "45.1.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
